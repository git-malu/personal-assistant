    "/invocations": {
      "post": {
        "summary": "Invocations",
        "description": "Agent invocation endpoint, supporting sync JSON and SSE streaming.",
        "operationId": "invocations_invocations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "conversation_id": {
                    "type": "string",
                    "format": "uuid",
                    "title": "Conversation Id",
                    "description": "Conversation receiving the message."
                  },
                  "client_message_id": {
                    "type": "string",
                    "format": "uuid",
                    "title": "Client Message Id",
                    "description": "Client-generated idempotency key for the user message."
                  },
                  "message": {
                    "type": "string",
                    "title": "Message",
                    "description": "User message sent to the Agent."
                  },
                  "stream": {
                    "type": "boolean",
                    "title": "Stream",
                    "description": "Return a Server-Sent Events stream instead of JSON.",
                    "default": false
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "conversation_id",
                  "client_message_id",
                  "message"
                ],
                "title": "InvocationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "JSON response when stream is false, or a Server-Sent Events stream when stream is true.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvocationResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Server-Sent Events stream."
                },
                "example": "data: {\"token\":\"你\",\"done\":false}\n\ndata: {\"token\":\"\",\"done\":true}\n\n"
              }
            }
          },
          "400": {
            "description": "Invalid JSON or invocation request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "406": {
            "description": "The Accept header excludes the selected response type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The Conversation cannot accept this Invocation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "The Invocation failed after execution began.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/oauth2/callback/m365-calendar": {
      "get": {
        "summary": "Calendar Oauth2 Callback",
        "description": "Complete Calendar OAuth2 from the backend-owned callback endpoint.",
        "operationId": "calendar_oauth2_callback_auth_oauth2_callback_m365_calendar_get",
        "responses": {
          "200": {
            "description": "Callback status as HTML for direct browser opens or JSON for the local development fallback.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "m365-calendar-auth",
                      "title": "Type",
                      "description": "Calendar OAuth2 callback envelope type."
                    },
                    "request_id": {
                      "type": "string",
                      "title": "Request Id",
                      "description": "OAuth2 state used as the UI request id."
                    },
                    "provider": {
                      "type": "string",
                      "title": "Provider",
                      "description": "AgentArts resource credential provider name."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "complete",
                        "failed",
                        "pending"
                      ],
                      "title": "Status",
                      "description": "Backend-owned OAuth2 completion status."
                    },
                    "message": {
                      "type": "string",
                      "title": "Message",
                      "description": "Human-readable callback status message."
                    },
                    "state": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "State",
                      "description": "OAuth2 state."
                    }
                  },
                  "type": "object",
                  "required": [
                    "type",
                    "request_id",
                    "provider",
                    "status",
                    "message"
                  ],
                  "title": "OAuth2CallbackResponse",
                  "description": "Calendar OAuth2 callback status returned to the BFF result page."
                }
              }
            }
          }
        }
      }
    }
  },
