# Personal Assistant Service — the single user-facing configuration catalog.
#
# Local:
#   cp .env.example .env
#
# Production:
#   Inject the same variable names through AgentArts Runtime / CI/CD.
#
# Secret values do NOT belong in this file. Configure them in AgentArts
# Identity using the provider names documented below.
#
# Convention:
# - Commented entries already have the shown default in app/settings.py.
# - Uncomment only values you want to override.
# - Entries without an application default would be uncommented and marked
#   required.

# =============================================================================
# Application
# =============================================================================

# Default: INFO. Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# =============================================================================
# LLM
# =============================================================================

# Built-in Provider catalog key. Default: deepseek.
# LLM_PROVIDER=deepseek

# Model name deployed by the selected Provider. Default: deepseek-v4-pro.
# LLM_MODEL=deepseek-v4-pro

# Optional OpenAI-compatible endpoint override.
# Default: use the built-in endpoint for LLM_PROVIDER.
# LLM_BASE_URL=https://api.example.com/v1

# AgentArts Identity API Key provider name. This is a reference, not a Secret.
# Create this provider in AgentArts Identity and store the real API key there.
# Default: DEEPSEEK_API_KEY.
# LLM_CREDENTIAL_PROVIDER=DEEPSEEK_API_KEY

# Request timeout is an application reliability guard, not a model sampling
# parameter. Sampling and output limits use the Provider/model defaults.
# LLM_TIMEOUT_SECONDS=60

# Process-scoped compiled Agent reuse window. When the TTL expires, the next
# request fetches the current API Key and atomically rebuilds the Agent Bundle.
# Default: 300 seconds. Must be greater than zero.
# LLM_AGENT_BUNDLE_TTL_SECONDS=300

# =============================================================================
# Persistence — choose at most one
# =============================================================================

# Local persistent checkpoint database.
# SQLITE_DB_PATH=.data/checkpoints.db

# Production PostgreSQL checkpoint database.
# Production requires TLS. URL-encode special characters in user/password.
# POSTGRES_DSN=postgresql://pa_app:password@host:5432/personal_assistant?sslmode=require

# When POSTGRES_DSN is set, the service also uses PostgreSQL for OAuth2
# callback replay/idempotency state. When both are empty, the service uses an
# in-memory Checkpointer and in-memory OAuth2 callback replay guards.

# =============================================================================
# AgentArts Identity integration references
# =============================================================================

# Customer-owned Agent Identity Workload Identity used only for local/manual
# JWT-mode WAT exchange when Gateway WAT is unavailable. This is not the
# Runtime service-created workload identity from .agentarts_config.yaml.
# First-time local Calendar OAuth2 setup: run
#   cd ../personal-assistant-infra
#   uv run python scripts/ensure_local_jwt_workload_identity.py --apply
# Default: pa-local-jwt-workload.
# AGENT_IDENTITY_LOCAL_JWT_WORKLOAD_NAME=pa-local-jwt-workload

# Gitee OAuth2 provider name. Default: gitee-provider.
# GITEE_PROVIDER_NAME=gitee-provider

# Huawei Cloud IAM STS provider configuration. Defaults shown below.
# IAM_USERS_PROVIDER_NAME=iam-users-readonly
# IAM_USERS_AGENCY_SESSION_NAME=personal-assistant-iam-users-readonly
# IAM_USERS_REGION=cn-southwest-2

# Optional endpoint override. Default: derive it from IAM_USERS_REGION.
# IAM_USERS_ENDPOINT=https://iam.cn-southwest-2.myhuaweicloud.com

# GitHub MCP activity data source. Enabled by default and requires an AgentArts
# MCP Gateway plus a read-only GitHub MCP Target created in Console.
# The Target must inject Authorization: Bearer <PAT> from AgentArts, never from
# Service environment variables.
# GITHUB_MCP_ENABLED=true
# GITHUB_MCP_GATEWAY_URL=https://gateway-github-mcp-defaultgw-ha3wenzqga.cn-southwest-2.huaweicloud-agentarts.com/mcp
# GITHUB_MCP_AUTH_MODE=iam
# GITHUB_MCP_STS_PROVIDER_NAME=github-mcp-gateway
# GITHUB_MCP_STS_AGENCY_SESSION_NAME=personal-assistant-github-mcp
# GITHUB_MCP_TIMEOUT_SECONDS=30
# Curated Agent-facing activity tools are enabled by default. They are registered
# only when both this setting and GITHUB_MCP_ENABLED are true.
# GITHUB_ACTIVITY_TOOLS_ENABLED=true

# Microsoft 365 Calendar OAuth2 full-flow configuration. Defaults shown below.
# M365_CALENDAR_PROVIDER_NAME=m365-calendar-provider
# M365_CALENDAR_SCOPES=https://graph.microsoft.com/Calendars.Read

# Calendar full OAuth2 frontend callback URL. Default is the deployed
# Cloudflare Pages callback URL. Override locally with the local Pages callback
# URL below.
# The value must be allowlisted in Microsoft Entra and AgentArts workload
# identity settings.
# OAUTH2_CALENDAR_CALLBACK_URL=http://localhost:5173/auth/callback/m365-calendar

# Required outside local development. Use a long random value.
# OAUTH2_STATE_SECRET=replace-with-random-secret

# Optional shared secret required from the Cloudflare Pages BFF callback when
# set. Use the same value as OAUTH2_CALLBACK_BFF_SECRET in Pages secrets.
# Do not set this for the default npm run pages:dev:local flow unless Wrangler
# local Pages Functions also injects the same header.
# OAUTH2_CALLBACK_BFF_SECRET=replace-with-random-bff-secret

# Calendar OAuth2 state replay window. Default: 600 seconds.
# OAUTH2_PENDING_AUTH_TTL_SECONDS=600

# Fixed integration provider names (not configurable):
# - GitHub OAuth2: github-provider
# - Microsoft 365 Email OAuth2: m365-email-provider

# GitHub OAuth2 scopes. Default: repo,read:user
# GITHUB_SCOPES=repo,read:user

# Microsoft Graph API base URL used by M365 mail/calendar tools.
# Default: https://graph.microsoft.com/v1.0/me
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0/me

# Calendar Graph request options. Defaults shown below.
# GRAPH_REQUEST_TIMEOUT_SECONDS=30
# GRAPH_TIMEZONE=Asia/Shanghai
